<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.acctileman">

    <!-- 允许修改安全设置（无障碍服务列表等），需通过 adb 或 Shizuku 授予 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QS Tile Service (Slot 1) -->
        <service
            android:name=".tile.TileService0"
            android:exported="true"
            android:icon="@drawable/ic_tile_copy"
            android:label="无障碍 1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE"
                android:value="true" />
        </service>

        <!-- QS Tile Service (Slot 2) -->
        <service
            android:name=".tile.TileService1"
            android:exported="true"
            android:icon="@drawable/ic_tile_copy"
            android:label="无障碍 2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE"
                android:value="true" />
        </service>

        <!-- QS Tile Service (Slot 3) -->
        <service
            android:name=".tile.TileService2"
            android:exported="true"
            android:icon="@drawable/ic_tile_copy"
            android:label="无障碍 3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE"
                android:value="true" />
        </service>

        <!-- FileProvider for log export via share intent -->
        <provider
            android:name=".LogFileProvider"
            android:authorities="com.example.acctileman.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
